# Generated code is compared byte for byte in CI, so a committed file must not be
# rewritten by line-ending normalisation on the way in. Without this, a contributor on
# Windows with core.autocrlf=true produces a diff that is not a contract change.
* text=auto eol=lf

*.py text eol=lf
*.pyi text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.md text eol=lf
justfile text eol=lf

*.png binary
*.parquet binary
